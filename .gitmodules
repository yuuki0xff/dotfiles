[submodule "files/.i3"]
	path = files/.i3
	url = https://github.com/yuuki0xff/i3-wm-config
[submodule "files/.zsh/zsh-completions"]
	path = files/.zsh/zsh-completions
	url = https://github.com/zsh-users/zsh-completions
[submodule "files/.zsh/zsh-syntax-highlighting"]
	path = files/.zsh/zsh-syntax-highlighting
	url = https://github.com/zsh-users/zsh-syntax-highlighting
[submodule "files/.vim/pack/color/start/molokai"]
	path = files/.vim/pack/color/start/molokai
	url = https://github.com/tomasr/molokai
